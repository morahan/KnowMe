{
  "name": "knowme",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/proxy/"
    ]
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-constants": "^58.0.14",
    "expo-dev-client": "^58.0.18",
    "expo-haptics": "^58.0.7",
    "expo-linking": "^58.0.15",
    "expo-router": "^58.0.29",
    "expo-splash-screen": "^58.0.12",
    "expo-sqlite": "^58.0.15",
    "expo-status-bar": "^58.0.4",
    "react": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^58.0.23",
    "eslint": "^9",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "typescript": "~6.0.3"
  }
}
