{
  "expo": {
    "name": "KnowMe",
    "slug": "knowme",
    "scheme": "knowme",
    "version": "0.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1115",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freiolabs.knowme",
      "appleTeamId": "CZK4R5DGMY",
      "buildNumber": "7",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.freiolabs.knowme",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1115"
      },
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withPlayCrashSymbols",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F1115",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0c332035-97c4-40f1-a065-84c6ad4702b5"
      }
    },
    "owner": "freiolabs"
  }
}
