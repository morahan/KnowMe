{
  "expo": {
    "name": "KnowMe",
    "slug": "knowme",
    "scheme": "knowme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1115",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash-icon.png", "backgroundColor": "#0F1115" },
    "ios": { "supportsTablet": true },
    "android": { "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0F1115" } },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-sqlite"]
  }
}
